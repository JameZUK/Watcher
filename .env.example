# Copy to .env and adjust. All keys are prefixed WATCHER_.

# Required in production: signs session cookies and webhook payloads.
WATCHER_SECRET_KEY=change-me-to-a-long-random-string

# Optional: explicit Fernet key for encrypting login credentials (base64, 32 bytes).
# If unset, a key is derived from SECRET_KEY (fine for dev).
# WATCHER_ENCRYPTION_KEY=

# Where the SQLite DB and snapshot blobs live.
WATCHER_DATA_DIR=data

# Server
WATCHER_HOST=0.0.0.0
WATCHER_PORT=8000

# Scheduling
WATCHER_MIN_INTERVAL_SECONDS=900
WATCHER_DEFAULT_INTERVAL_SECONDS=3600
WATCHER_MAX_RENDER_CONCURRENCY=3

# Retention
WATCHER_RETENTION_MAX_SNAPSHOTS=50
WATCHER_RETENTION_MAX_DAYS=90

# Web Push (generate a keypair: `pip install py-vapid && vapid --gen`)
# WATCHER_VAPID_PUBLIC_KEY=
# WATCHER_VAPID_PRIVATE_KEY=
# WATCHER_VAPID_SUBJECT=mailto:you@example.com
