# Copy to .env and adjust. All keys are prefixed WATCHER_.

# Required in production: signs session cookies and webhook payloads.
WATCHER_SECRET_KEY=change-me-to-a-long-random-string

# Optional: explicit Fernet key for encrypting login credentials (base64, 32 bytes).
# Recommended in production. If unset, a key is HKDF-derived from SECRET_KEY.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# WATCHER_ENCRYPTION_KEY=

# The app REFUSES to start with a weak/default SECRET_KEY. Set this to override
# in local dev only (never in production).
# WATCHER_ALLOW_INSECURE=false

# Public-exposure hardening:
WATCHER_SECURE_COOKIES=false        # set true behind HTTPS (Secure cookie + HSTS)
WATCHER_REGISTRATION_OPEN=false     # false = only the first (bootstrap) account may self-register
WATCHER_ENABLE_DOCS=false           # expose /docs, /redoc, /openapi.json
WATCHER_ALLOW_PRIVATE_TARGETS=false # allow monitors/notifications to reach private IPs (SSRF)
WATCHER_MAX_MONITORS_PER_USER=100   # 0 = unlimited
WATCHER_MANUAL_CHECK_COOLDOWN_SECONDS=20
WATCHER_MAX_REQUEST_BYTES=2000000   # request body ceiling (~2 MB)
WATCHER_LOGIN_MAX_ATTEMPTS=10       # per IP per window (login + register throttle)
WATCHER_LOGIN_WINDOW_SECONDS=300
# Public hostname(s) for the CSRF/Origin check when behind a reverse proxy.
# WATCHER_TRUSTED_HOSTS=watcher.example.com

# Where the SQLite DB and snapshot blobs live.
WATCHER_DATA_DIR=data

# Server
WATCHER_HOST=0.0.0.0
WATCHER_PORT=8000

# Scheduling
WATCHER_MIN_INTERVAL_SECONDS=900
WATCHER_DEFAULT_INTERVAL_SECONDS=3600
WATCHER_MAX_RENDER_CONCURRENCY=3

# Reliability
WATCHER_RENDER_TIMEOUT_SECONDS=45
WATCHER_DETECT_TIMEOUT_SECONDS=20
WATCHER_AUTO_PAUSE_AFTER_FAILURES=6   # 0 disables auto-pause

# Detection sensitivity
# Minimum fraction of pixels (0..1) that must differ before a *visual* change
# counts — a noise floor that absorbs anti-aliasing, lazy-loaded images, and
# carousels. Acts as a lower bound on each monitor's own min-change threshold.
WATCHER_MIN_VISUAL_CHANGE=0.005       # 0.5% of the screenshot

# Retention
WATCHER_RETENTION_MAX_SNAPSHOTS=50
WATCHER_RETENTION_MAX_DAYS=90

# Web Push (generate a keypair: `pip install py-vapid && vapid --gen`)
# WATCHER_VAPID_PUBLIC_KEY=
# WATCHER_VAPID_PRIVATE_KEY=
# WATCHER_VAPID_SUBJECT=mailto:you@example.com

# AI triage and the SMTP / Telegram / ntfy credentials are configured in the web
# UI (Settings → admin) and stored encrypted at rest — not via env vars.
